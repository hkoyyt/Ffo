local currentAutoPartIndex = 1
local autoPartList = {"Head", "UpperTorso", "HumanoidRootPart"}
task.spawn(function()
    while task.wait(0.5) do
        currentAutoPartIndex = currentAutoPartIndex % #autoPartList + 1
    end
end)

local function GetTargetPart(char)
    if not char then return nil end
    if Config.AimPartMode:find("สลับออโต้") then
        return char:FindFirstChild(autoPartList[currentAutoPartIndex]) or char:FindFirstChild("Head")
    elseif Config.AimPartMode:find("ล็อกหัว") then
        return char:FindFirstChild("Head")
    elseif Config.AimPartMode:find("ล็อกคอ") then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    elseif Config.AimPartMode:find("ล็อกตัว") then
        return char:FindFirstChild("HumanoidRootPart")
    end
    return char:FindFirstChild("Head")
end

local function GetClosestTarget()
    if not Camera then return nil end
    local bestTargetPart = nil
    local maxDist = Config.FOVSize
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local part = GetTargetPart(p.Character)
                if part then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if dist < maxDist then
                            maxDist = dist
                            bestTargetPart = part
                        end
                    end
                end
            end
        end
    end
    return bestTargetPart
end

local hue = 0
local spinAngle = 0

RunService.RenderStepped:Connect(function()
    if not Camera then return end
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    -- 1. FOV & Crosshair
    FOVCircle.Position = screenCenter
    FOVCircle.Radius = Config.FOVSize
    
    if Config.ShowFOV then
        hue = (hue + 0.006) % 1
        local rainbowColor = Color3.fromHSV(hue, 1, 1)
        FOVCircle.Color = rainbowColor
        CenterCross1.Color = rainbowColor
        CenterCross2.Color = rainbowColor
        
        local crossSize = 5
        CenterCross1.From = Vector2.new(screenCenter.X - crossSize, screenCenter.Y)
        CenterCross1.To = Vector2.new(screenCenter.X + crossSize, screenCenter.Y)
        CenterCross2.From = Vector2.new(screenCenter.X, screenCenter.Y - crossSize)
        CenterCross2.To = Vector2.new(screenCenter.X, screenCenter.Y + crossSize)
    end

    -- 2. Aimbot
    if Config.Aimbot then
        local targetPart = GetClosestTarget()
        if targetPart then
            local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, math.clamp(Config.Smoothness, 0.01, 1))
        end
    end

    -- 3. Character Hacks, Anti-Stagger & Spin Bot Free Fire Style
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if hum then
            if Config.JumpHack then
                hum.UseJumpPower = true
                hum.JumpPower = Config.JumpPower
            end
            
            if Config.SpinBot and hrp then
                pcall(function()
                    spinAngle = (spinAngle + 45) % 360
                    hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(spinAngle), 0)
                end)
            end
            
            if Config.AntiRagdoll then
                pcall(function()
                    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Stunned, false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
                    
                    local state = hum:GetState()
                    if state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown or state == Enum.HumanoidStateType.PlatformStanding or state == Enum.HumanoidStateType.Stunned or state == Enum.HumanoidStateType.GettingUp then
                        hum:ChangeState(Enum.HumanoidStateType.Running)
                    end
                end)
                
                if hrp and not Config.SpinBot then
                    pcall(function()
                        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        local vel = hrp.AssemblyLinearVelocity
                        if math.abs(vel.X) > 40 or math.abs(vel.Z) > 40 or math.abs(vel.Y) > 40 then
                            hrp.AssemblyLinearVelocity = Vector3.new(0, math.clamp(vel.Y, -5, 5), 0)
                        end
                    end)
                end
            end
        end
    end

    -- 4. Player ESP & Red Chams
    local espActive = Config.ESPHealth or Config.ESPLevel or Config.ESPInventory or Config.ESPDistance
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")

            if hum and hrp and hum.Health > 0 then
                local highlight = char:FindFirstChild("KingRedChamsHighlight")
                if Config.RedChams then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "KingRedChamsHighlight"
                        highlight.Adornee = char
                        highlight.FillColor = Color3.fromRGB(255, 0, 0)
                        highlight.FillTransparency = 0.4
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.OutlineTransparency = 0
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.Parent = char
                    end
                else
                    if highlight then highlight:Destroy() end
                end

                local bb = char:FindFirstChild("KingESPBoard")
                if espActive then
                    if not bb then
                        bb = Instance.new("BillboardGui")
                        bb.Name = "KingESPBoard"
                        bb.Size = UDim2.new(0, 120, 0, 75)
                        bb.Adornee = hrp
                        bb.AlwaysOnTop = true
                        bb.StudsOffset = Vector3.new(0, 2.2, 0)

                        local container = Instance.new("Frame")
                        container.Name = "Container"
