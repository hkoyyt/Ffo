-- ฟังก์ชันดึง Level
local function GetPlayerLevel(player)
    local stats = player:FindFirstChild("leaderstats") or player:FindFirstChild("Data") or player:FindFirstChild("Stats") or player:FindFirstChild("PlayerData")
    local lvl = "N/A"
    if stats then
        local lObj = stats:FindFirstChild("Level") or stats:FindFirstChild("Lvl") or stats:FindFirstChild("PlayerLevel")
        if lObj then lvl = lObj.Value end
    end
    return lvl
end

-- ฟังก์ชันดึงชื่อไอเทม
local function GetToolEnglishName(tool)
    if not tool then return "" end
    local realName = tool:GetAttribute("ItemName") or tool:GetAttribute("Name") or (tool.ToolTip ~= "" and tool.ToolTip)
    if realName and type(realName) == "string" and not tonumber(realName) then return realName end
    return tool.Name
end

-- ฟังก์ชันรวบรวมไอเทมในกระเป๋า
local function GetAllPlayerItems(player, char)
    local items = {}
    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then
        table.insert(items, "[ถือ] " .. GetToolEnglishName(currentTool))
    end
    
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(items, GetToolEnglishName(item))
            end
        end
    end
    
    if #items == 0 then return "ไม่มีไอเทม (Empty)" end
    return table.concat(items, "\n")
end

